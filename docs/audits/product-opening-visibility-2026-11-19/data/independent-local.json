    {
      "locale": "ar",
      "width": 390,
      "route": "/core",
      "status": 200,
      "h1": "\u0627\u0639\u0631\u0641 \u0644\u0645\u0627\u0630\u0627 \u062a\u062a\u063a\u064a\u0631 \u0627\u0644\u0645\u0628\u064a\u0639\u0627\u062a \u0648\u0627\u0644\u062a\u0643\u0627\u0644\u064a\u0641. \u0648\u062d\u062f\u062f \u0627\u0644\u062e\u0637\u0648\u0629 \u0627\u0644\u062a\u0627\u0644\u064a\u0629.",
      "opening": [
        {
          "tag": "H1",
          "text": "\u0627\u0639\u0631\u0641 \u0644\u0645\u0627\u0630\u0627 \u062a\u062a\u063a\u064a\u0631 \u0627\u0644\u0645\u0628\u064a\u0639\u0627\u062a \u0648\u0627\u0644\u062a\u0643\u0627\u0644\u064a\u0641. \u0648\u062d\u062f\u062f \u0627\u0644\u062e\u0637\u0648\u0629 \u0627\u0644\u062a\u0627\u0644\u064a\u0629.",
          "hidden": []
        },
        {
          "tag": "P",
          "text": "\u064a\u062c\u0645\u0639 Core \u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u062a\u0634\u063a\u064a\u0644 \u0648\u0645\u0642\u0627\u0631\u0646\u0627\u062a \u0627\u0644\u0645\u0634\u063a\u0651\u0644\u064a\u0646 \u0627\u0644\u0645\u0634\u0627\u0628\u0647\u064a\u0646 \u0648\u0625\u0634\u0627\u0631\u0627\u062a \u0627\u0644\u0633\u0648\u0642 \u0630\u0627\u062a \u0627\u0644\u0635\u0644\u0629 \u0644\u0634\u0631\u062d \u062a\u063a\u064a\u0631\u0627\u062a \u0627\u0644\u0645\u0628\u064a\u0639\u0627\u062a \u0648\u0627\u0644\u062a\u0643\u0627\u0644\u064a\u0641 \u0648\u0627\u0644\u0623\u0631\u0628\u0627\u062d. \u0627",
          "hidden": []
        },
        {
          "tag": "A",
          "text": "\u0627\u0633\u062a\u0639\u0631\u0636 \u0645\u0633\u062a\u0648\u064a\u0627\u062a Core",
