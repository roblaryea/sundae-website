    {
      "locale": "ar",
      "width": 390,
      "route": "/crew",
      "status": 200,
      "h1": "\u0646\u0638\u0651\u0645 \u0637\u0627\u0642\u0645\u0643. \u0623\u062f\u0650\u0631 \u0627\u0644\u0634\u064a\u0641\u062a.",
      "opening": [
        {
          "tag": "H1",
          "text": "\u0646\u0638\u0651\u0645 \u0637\u0627\u0642\u0645\u0643. \u0623\u062f\u0650\u0631 \u0627\u0644\u0634\u064a\u0641\u062a.",
          "hidden": []
        },
        {
          "tag": "P",
          "text": "\u0625\u062f\u0627\u0631\u0629 \u0627\u0644\u0643\u0648\u0627\u062f\u0631 \u0648\u0627\u0644\u0639\u0645\u0644\u064a\u0627\u062a \u0627\u0644\u064a\u0648\u0645\u064a\u0629 \u0644\u0645\u062c\u0645\u0648\u0639\u0627\u062a \u0627\u0644\u0636\u064a\u0627\u0641\u0629 \u0648\u062e\u062f\u0645\u0627\u062a \u0627\u0644\u0637\u0639\u0627\u0645. \u0623\u0646\u0634\u0626 \u0627\u0644\u062c\u062f\u0627\u0648\u0644 \u0648\u062a\u0627\u0628\u0639 \u0627\u0644\u062d\u0636\u0648\u0631 \u0648\u0623\u062f\u0650\u0631 \u0627\u0644\u0645\u0647\u0627\u0645 \u0648\u062a\u0633\u0644\u064a\u0645 \u0627\u0644\u0648\u0631\u062f\u064a\u0627\u062a \u0648",
          "hidden": []
        },
        {
          "tag": "A",
          "text": "\u0627\u062d\u062c\u0632 \u062c\u0648\u0644\u0629 Crew",
          "hidden": []
        },
        {
          "tag": "A",
          "text": "\u0634\u0627\u0647\u062f Sundae \u0641\u064a \u0627\u0644\u062a\u0637\u0628\u064a\u0642",
          "hidden": []
        },
        {
          "tag": "IMG",
          "text": "\u0642\u0648\u0627\u0644\u0628 \u0642\u0627\u0628\u0644\u0629 \u0644\u0625\u0639\u0627\u062f\u0629 \u0627\u0644\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0644\u0644\u0639\u0645\u0644 \u0627\u0644\u064a\u0648\u0645\u064a.",
          "hidden": []
        },
        {
          "tag": "P",
          "text": "\u0639\u0631\u0636 \u0645\u0646 \u0627\u0644\u0645\u0646\u062a\u062c \u0646\u0641\u0633\u0647 \u00b7 \u0628\u064a\u0627\u0646\u0627\u062a \u062a\u062c\u0631\u064a\u0628\u064a\u0629 \u00b7 \u0648\u0627\u062c\u0647\u0629 \u0625\u0646\u062c\u0644\u064a\u0632\u064a\u0629. \u0627\u0644\u0623\u0631\u0642\u0627\u0645 \u0644\u064a\u0633\u062a \u0646\u062a\u0627\u0626\u062c \u0639\u0645\u0644\u0627\u0621.",
          "hidden": []
        },
        {
          "tag": "A",
          "text": "\u0639\u0631\u0636 \u0628\u0627\u0644\u062d\u062c\u0645 \u0627\u0644\u0643\u0627\u0645\u0644 \u2197",
